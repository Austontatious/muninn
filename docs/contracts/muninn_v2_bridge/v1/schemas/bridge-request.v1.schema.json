{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.muninn.dev/v2-bridge/v1/bridge-request.v1.schema.json",
  "title": "Muninn v2 BridgeRequestV1",
  "description": "Operation-oriented read-only Muninn v2 bridge request envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "operation",
    "consumer_id"
  ],
  "properties": {
    "schema_version": {
      "const": "BridgeRequestV1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "health",
        "search",
        "rehydrate",
        "explain"
      ]
    },
    "consumer_id": {
      "type": "string",
      "minLength": 1
    },
    "query": {
      "type": "string"
    },
    "card_id": {
      "type": "string"
    },
    "space_key": {
      "type": "string"
    },
    "project_path": {
      "type": "string"
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    },
    "primary_limit": {
      "type": "integer",
      "minimum": 1
    },
    "max_context_chars": {
      "type": "integer",
      "minimum": 1
    },
    "retrieval_mode": {
      "enum": [
        "hybrid",
        "lexical",
        "vector"
      ]
    },
    "include_evidence": {
      "type": "boolean"
    },
    "include_explanations": {
      "type": "boolean"
    },
    "allow_adaptive_scoring": {
      "type": "boolean"
    },
    "allow_reinforcement_write": {
      "type": "boolean"
    },
    "recent_supplement": {
      "type": "boolean"
    },
    "strict": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "search"
          }
        }
      },
      "then": {
        "required": [
          "query",
          "space_key",
          "project_path"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "rehydrate"
          }
        }
      },
      "then": {
        "required": [
          "query",
          "space_key",
          "project_path"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "explain"
          }
        }
      },
      "then": {
        "required": [
          "card_id",
          "space_key",
          "project_path"
        ]
      }
    }
  ]
}
