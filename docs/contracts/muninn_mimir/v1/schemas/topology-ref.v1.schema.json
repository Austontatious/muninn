{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.muninn-mimir.dev/v1/topology-ref.v1.schema.json",
  "title": "Muninn-Mimir Topology/Binding Reference Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ref_kind",
    "ref_id",
    "relation"
  ],
  "properties": {
    "ref_kind": {
      "type": "string",
      "enum": [
        "anchor",
        "card",
        "node",
        "edge",
        "source",
        "chunk",
        "entity",
        "symbol",
        "file",
        "space",
        "policy"
      ]
    },
    "ref_id": {
      "type": "string",
      "minLength": 1
    },
    "relation": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "line_start": {
      "type": "integer",
      "minimum": 1
    },
    "line_end": {
      "type": "integer",
      "minimum": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "metadata": {
      "type": "object"
    }
  },
  "dependentRequired": {
    "line_end": [
      "line_start"
    ]
  }
}
