{
  "contract_set": "muninn-mimir-shared",
  "current_version": "1.0.0",
  "schema_family": "v1",
  "compatibility_policy": {
    "backward_compatible": [
      "Add optional fields only.",
      "Add enum values only when both repos can safely ignore unknown values.",
      "Add new examples and tests without changing required semantics."
    ],
    "breaking": [
      "Remove or rename required fields.",
      "Narrow enum values or change existing value meaning.",
      "Change envelope meaning without a new contract version."
    ],
    "required_on_change": [
      "Update schemas and examples in both repos.",
      "Update CROSS_PROJECT_COMPATIBILITY docs in both repos.",
      "Update compatibility tests in both repos.",
      "Record deferred downstream compatibility impact explicitly if not addressed now."
    ]
  },
  "schemas": {
    "card_envelope": "schemas/card-envelope.v1.schema.json",
    "lifecycle_state": "schemas/lifecycle-state.v1.schema.json",
    "provenance_envelope": "schemas/provenance-envelope.v1.schema.json",
    "confidence_trust": "schemas/confidence-trust.v1.schema.json",
    "rehydrate_request": "schemas/rehydrate-request.v1.schema.json",
    "rehydrate_response": "schemas/rehydrate-response.v1.schema.json",
    "topology_ref": "schemas/topology-ref.v1.schema.json"
  },
